NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/tracks-n-stacks

# JWT
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Red5 Pro Media Server
RED5_HOST=localhost
RED5_PORT=5080
RED5_API_KEY=your_red5_api_key
RED5_RTMP_PORT=1935
RED5_APP_NAME=live

# CORS
FRONTEND_URL=http://localhost:3000

# Stream settings
MAX_STREAM_DURATION_HOURS=6
