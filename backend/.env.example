NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/tracks-n-stacks

# JWT
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Red5 Community Edition Media Server (self-hosted at media.tracksnstacks.com)
RED5_HOST=media.tracksnstacks.com
RED5_PORT=5080
RED5_USERNAME=admin
RED5_PASSWORD=your_red5_password
RED5_RTMP_PORT=1935
RED5_APP_NAME=live

# CORS
FRONTEND_URL=http://localhost:3000

# Stream settings
MAX_STREAM_DURATION_HOURS=6
